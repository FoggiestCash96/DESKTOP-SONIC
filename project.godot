[internationalization]

locale/translations=PackedStringArray("res://content/sonic/ui/translations/strings.en.translation")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="gimmicks"
3d_physics/layer_5="collectibles"
3d_physics/layer_6="hazards"
3d_physics/layer_7="water"
3d_physics/layer_8="camera_collision"

[physics]

common/physics_ticks_per_second=120
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
